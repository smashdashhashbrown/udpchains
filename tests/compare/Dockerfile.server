# The server: an echo server and a resolver, both logging their sources.
FROM ubuntu@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    gcc libc6-dev dnsmasq && rm -rf /var/lib/apt/lists/*
COPY tests/compare/server.c /src/
RUN cc -std=c11 -D_GNU_SOURCE -Wall -O2 -o /usr/local/bin/server /src/server.c
